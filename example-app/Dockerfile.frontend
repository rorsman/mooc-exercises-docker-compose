FROM ubuntu:24.04

RUN apt-get update
RUN apt-get install -y  curl 
RUN curl -sL https://deb.nodesource.com/setup_16.x | bash
RUN apt install -y nodejs

EXPOSE 5001

WORKDIR /usr/src/app

COPY frontend .

RUN npm install

RUN npm run build

RUN npm install -g serve

CMD [ "serve", "-s", "-l", "5001", "build" ]